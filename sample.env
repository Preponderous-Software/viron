# GENERAL
SPRING_APPLICATION_NAME=viron
SERVER_PORT=9999

# postgres
DATABASE_DB_HOST=postgres
DATABASE_DB_PORT=5432
DATABASE_DB_NAME=postgres
DATABASE_DB_USERNAME=postgres
DATABASE_DB_PASSWORD=postgres
# Longest a request waits for a row lock (milliseconds; 0 = wait indefinitely) and the size of
# the pool that wait is drawn against. Set as a pair; see README.md.
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_MAX_POOL_SIZE=10

# service
SERVICE_VIRON_HOST=http://localhost
SERVICE_VIRON_PORT=9999

# debug
# Registers the /api/v1/debug data-seeding endpoints. Leave false outside local/dev.
VIRON_DEBUG_ENABLED=false

# jwt
# Required: the service refuses to start without it. Must match the UserAuth service's
# JWT_SECRET, and for HS256 must be at least 32 bytes. Replace the sample value below.
JWT_SECRET=replace-me-with-the-userauth-secret-at-least-32-bytes
JWT_ISSUER=userauth
JWT_ALGORITHM=HS256

# usage reporting
# One "startup" event (program name, version, service=true) is sent to the trace service on
# start-up; nothing per request. Set to false to turn it off. See README.md.
USAGE_REPORTING_ENABLED=true
